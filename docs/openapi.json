{
  "openapi": "3.1.0",
  "info": {
    "title": "PS5 AI WAI Images API",
    "version": "1.2.0-controlnet-candidate",
    "description": "OpenAI Images generation protocol subset. The CPU gateway on PS5 forwards to the same console native GPU engine8188. No cloud or Windows inference. n=1, PNG, non-streaming. LAN /24 only. Legacy async API remains on8188. URL results are image-only signed capabilities valid up to1hour; the API secret is never put in URLs. Multipart edits support img2img, IP-Adapter Plus or combined mode. No masks/inpainting, remote image URLs, streaming or multi-image batch. WAI extensions controlnet/control_image_id/control_strength select one same-console Vulkan ControlNet and an authenticated prepared edge/pose map. No automatic pose detector."
  },
  "servers": [
    {
      "url": "http://192.168.68.67:8189"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ImageRequest": {

          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Maximum4096 UTF-8 bytes"
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "wai-illustrious-sdxl-v17.0"
            ],
            "description": " Null uses the default."
          },
          "n": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              1
            ],
            "default": 1,
            "description": " Null uses the default."
          },
          "size": {
            "type": [
              "string",
              "null"
            ],
            "default": "1024x1024",
            "description": "auto, or WIDTHxHEIGHT; dimensions64..1024 and multiples of64 Null uses the default."
          },
          "response_format": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "b64_json",
              "url"
            ],
            "default": "b64_json",
            "description": " Null uses the default."
          },
          "quality": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "auto",
              "standard"
            ],
            "description": " Null uses the default."
          },
          "background": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "auto",
              "opaque"
            ],
            "description": " Null uses the default."
          },
          "output_format": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "png"
            ],
            "description": " Null uses the default."
          },
          "stream": {
            "type": [
              "boolean",
              "null"
            ],
            "enum": [
              false
            ],
            "description": " Null uses the default."
          },
          "user": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256,
            "description": " Null uses the default."
          },
          "safety_identifier": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256,
            "description": " Null uses the default."
          },
          "negative_prompt": {
            "type": [
              "string",
              "null"
            ],
            "description": "PS5 extension; maximum4096 UTF-8 bytes Null uses the default."
          },
          "steps": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100,
            "default": 8,
            "description": " Null uses the default."
          },
          "cfg_scale": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 30,
            "default": 5,
            "description": " Null uses the default."
          },
          "seed": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": -1,
            "maximum": 9223372036854775807,
            "default": -1,
            "description": " Null uses the default."
          },
          "sampler": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "euler",
              "euler_a",
              "dpm++2m"
            ],
            "default": "euler_a",
            "description": " Null uses the default."
          },
          "manga_strength": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1.5,
            "default": 1
          },
          "manga_monochrome": {
            "type": [
              "boolean",
              "null"
            ],
            "default": false,
            "description": "WAI extension: opt in to monochrome prompt prefix when manga LoRA is enabled; omitted/null leaves the prompt unchanged"
          },
          "init_image_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{32}$",
            "description": "WAI extension: authenticated native input ID on8188"
          },
          "reference_image_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{32}$",
            "description": "WAI extension: IP-Adapter input ID on8188"
          },
          "denoise_strength": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0.01,
            "maximum": 1,
            "default": 0.6,
            "description": "WAI extension, requires init image; actual sampler steps can be fewer than requested"
          },
          "ip_adapter_strength": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0.01,
            "maximum": 1.5,
            "default": 0.7,
            "description": "WAI extension, requires reference image; not OpenAI input_fidelity"
          },
          "controlnet": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "canny",
              "openpose",
              null
            ],
            "description": "WAI extension: one ControlNet model at a time"
          },
          "control_image_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{32}$",
            "description": "WAI extension: RGB edge/pose map uploaded to authenticated native8188 /api/inputs; dimensions must match requested size"
          },
          "control_strength": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0.01,
            "maximum": 1.5,
            "default": 1
          }
        }
      },

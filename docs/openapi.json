{
  "openapi": "3.1.0",
  "info": {
    "title": "PS5 AI Anima Images API",
    "version": "0.1.0-text2img",
    "description": "OpenAI Images generation protocol subset for Anima Turbo v1.1. The CPU gateway on PS5 port8191 forwards exactly one job to the same-console native GPU engine on8190. All inference runs onPS5. PNG, n=1, non-streaming, Bearer authentication and same-LAN /24 access only. Native asynchronous jobs remain on8190. Returned image URLs are image-only HMAC capabilities valid up to1hour; API secrets are never put in URLs. Text-to-image only in this version. SDXL manga LoRA, IP-Adapter, ControlNet, img2img, masks and inpainting are unsupported and explicitly rejected; WAI models and ports8188/8189 are not reused."
  },
  "servers": [
    {
      "url": "http://{ps5_host}:8191",
      "variables": {
        "ps5_host": {
          "default": "192.168.1.100",
          "description": "Your PS5 private LAN IPv4 address"
        }
      }
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ImageRequest": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Maximum4096 UTF-8 bytes"
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "anima-turbo-v1.1",
              null
            ],
            "description": " Null uses the default."
          },
          "n": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              1,
              null
            ],
            "default": 1,
            "description": " Null uses the default."
          },
          "size": {
            "type": [
              "string",
              "null"
            ],
            "default": "1024x1024",
            "description": "auto, or WIDTHxHEIGHT; dimensions64..1024 and multiples of64 Null uses the default."
          },
          "response_format": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "b64_json",
              "url",
              null
            ],
            "default": "b64_json",
            "description": " Null uses the default."
          },
          "quality": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "auto",
              "standard",
              null
            ],
            "description": " Null uses the default."
          },
          "background": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "auto",
              "opaque",
              null
            ],
            "description": " Null uses the default."
          },
          "output_format": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "png",
              null
            ],
            "description": " Null uses the default."
          },
          "stream": {
            "type": [
              "boolean",
              "null"
            ],
            "enum": [
              false,
              null
            ],
            "description": " Null uses the default."
          },
          "user": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256,
            "description": " Null uses the default."
          },
          "safety_identifier": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256,
            "description": " Null uses the default."
          },
          "negative_prompt": {
            "type": [
              "string",
              "null"
            ],
            "description": "PS5 extension; maximum4096 UTF-8 bytes Null uses the default."
          },
          "steps": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100,
            "default": 8,
            "description": " Null uses the default."
          },
          "cfg_scale": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 30,
            "default": 1,
            "description": " Null uses the default."
          },
          "seed": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": -1,
            "maximum": 9223372036854775807,
            "default": -1,
            "description": " Null uses the default."
          },
          "sampler": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "euler",
              "euler_a",
              "dpm++2m",
              null
            ],
            "default": "euler",
            "description": " Null uses the default."
          },
          "manga_strength": {
            "type": [
              "number",
              "null"
            ],
            "enum": [
              0,
              null
            ],
            "default": 0,
            "description": "Compatibility field: fixed0. SDXL manga LoRA is incompatible with Anima."
          },
          "manga_monochrome": {
            "type": [
              "boolean",
              "null"
            ],
            "enum": [
              false,
              null
            ],
            "default": false,
            "description": "Compatibility field: fixedfalse. No automatic monochrome prompt is added."
          }
        }
      }
    }
  },
  "paths": {
    "/v1/images/generations": {
      "post": {
        "operationId": "generateImage",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One PNG as base64 or signed URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "created",
                    "data"
                  ],
                  "properties": {
                    "created": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "items": {
                        "type": "object",
                        "properties": {
                          "b64_json": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {

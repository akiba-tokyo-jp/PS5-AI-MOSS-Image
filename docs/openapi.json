    "/v1/images/{image_id}.png": {
      "get": {
        "operationId": "getSignedImage",
        "description": "Implemented image-only HMAC URL route (up to1hour). Use the exact returned URL; it is an access capability for that image. Bearer alone does not replace the signature. Base64/native image validation results do not imply an independent signed-URL runtime test.",
        "security": [],
        "parameters": [
          {
            "name": "image_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          },
          {
            "name": "expires",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "signature",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PNG",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "OpenAI-shaped error",
            "content": {

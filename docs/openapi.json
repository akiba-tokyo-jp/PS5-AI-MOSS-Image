    "/v1/images/{image_id}.png": {
      "get": {
        "operationId": "getSignedImage",
        "description": "Use the exact returned URL. It includes a one-hour image-only HMAC capability; Bearer authentication alone does not replace a valid signature on this route. The signed URL grants access to this image only.",
        "security": [],
        "parameters": [
          {
            "name": "image_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          },
          {
            "name": "expires",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "signature",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PNG",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "OpenAI-shaped error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",

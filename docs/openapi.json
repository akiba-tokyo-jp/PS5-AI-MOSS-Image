{
  "openapi": "3.1.0",
  "info": {
    "title": "PS5 AI MOSS Image API",
    "version": "0.4.0-service",
    "description": "PS5 MOSS Turbo4 serial image service. No prerequisite256 generation, fixed prompt/seed, or lifetime attempt cap. Same-console native8192 and OpenAI-style gateway8193; bearer and private IPv4 /24. Output64..1024 on16-pixel grid, arbitrary aspect ratio; PNG,n=1, no streaming. Turbo adapter authored4 Euler steps/CFG1/sigmas [1,.910,.717,.024,0] form the model profile. Img2img uses PS5 VAE encode and actual1..4 authored suffix forwards. Service mode preserves numeric/capacity/GPU/ownership admission. Older diagnostic builds expose their own runtime health and retain their former limits."
  },
  "servers": [
    {
      "url": "http://{ps5_host}:8193",
      "variables": {
        "ps5_host": {
          "default": "192.168.1.100",
          "description": "Your PS5 private LAN IPv4 address"
        }
      }
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ImageRequest": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Caller text, nonempty and <=4096 UTF-8 bytes. No canonical prompt or hidden subject/style additions."
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "moss-image-sft",
              null
            ],
            "description": " Null uses the default."
          },
          "n": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              1,
              null
            ],
            "default": 1,
            "description": " Null uses the default."
          },
          "size": {
            "type": [
              "string",
              "null"
            ],
            "default": "1024x1024",
            "description": "auto/null/omission selects1024x1024. Each dimension64..1024 divisible16; rectangular output is allowed. Cold1024 is accepted without a256 job.",
            "pattern": "^(auto|[0-9]{2,4}x[0-9]{2,4})$"
          },
          "response_format": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "b64_json",
              "url",
              null
            ],
            "default": "b64_json",
            "description": " Null uses the default."
          },
          "quality": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "auto",
              "standard",
              null
            ],
            "description": " Null uses the default."
          },
          "background": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "auto",
              "opaque",
              null
            ],
            "description": " Null uses the default."
          },
          "output_format": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "png",
              null
            ],
            "description": " Null uses the default."
          },
          "stream": {
            "type": [
              "boolean",
              "null"
            ],
            "enum": [
              false,
              null
            ],
            "description": " Null uses the default."
          },
          "user": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256,
            "description": "Accepted compatibility metadata only, maximum256 UTF-8 bytes; not a moderation service. Omission/null leaves it unused."
          },
          "safety_identifier": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256,
            "description": "Accepted compatibility metadata only, maximum256 UTF-8 bytes; not a moderation service. Omission/null leaves it unused."
          },
          "negative_prompt": {
            "type": [
              "string",
              "null"
            ],
            "description": "Caller text <=4096 UTF-8 bytes; omitted/null is empty. CFG1 does not execute a negative CFG forward."
          },
          "steps": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              4,
              null
            ],
            "default": 4,
            "description": "The selected Turbo4 adapter profile uses4 Euler steps. Other step counts need a different sampling/model profile; not an attempt or startup restriction."
          },
          "cfg_scale": {
            "type": [
              "number",
              "null"
            ],
            "enum": [
              1,
              null
            ],
            "default": 1,
            "description": "Fixed CFG1. No negative CFG DiT forward is run. Null uses1."
          },
          "seed": {
            "type": [
              "integer",
              "null"
            ],
            "default": -1,
            "description": "Any integer -1..INT64_MAX. -1/null/omission resolves a varying seed on PS5 before job persistence; actual value is returned in native job.seed and X-PS5-Seed.",
            "minimum": -1,
            "maximum": 9223372036854775807
          },
          "sampler": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "euler",
              null
            ],
            "default": "euler",
            "description": "Fixed Euler for the compiled author sigma grid. Null uses Euler."
          },
          "manga_strength": {
            "type": [
              "number",
              "null"
            ],
            "enum": [
              0,
              null
            ],
            "default": 0,
            "description": "Legacy disabled ABI field only:0/null. It does not enable a manga LoRA."
          },
          "manga_monochrome": {
            "type": [
              "boolean",
              "null"
            ],
            "enum": [
              false,
              null
            ],
            "default": false,
            "description": "Legacy disabled ABI field only:false/null. No monochrome prompt is injected."
          },
          "flow_shift": {
            "type": [
              "number",
              "null"
            ],
            "enum": [
              5,
              null
            ],
            "default": 5,
            "description": "Fixed flow_shift5 contract. The authored custom sigmas are already shifted and are not shifted again. Null uses5."
          },
          "init_image_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "description": "Native authenticated input-store ID; normally created internally by multipart /v1/images/edits. No filesystem paths or URLs."
          },
          "denoise_strength": {
            "type": "number",
            "minimum": 0.01,
            "default": 0.5,
            "description": "Step-fraction strength0.01..1. Floats <.25/<.5/<.75/otherwise select actual1/2/3/4 forwards. >=.75 starts at sigma1 and fully resamples, so source latent contribution is zero. This is not an identity adapter.",
            "maximum": 1
          }
        }
      }
    }
  },
  "paths": {
    "/v1/images/generations": {
      "post": {
        "operationId": "generateImage",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageRequest"
              },
              "example": {
                "model": "moss-image-sft",
                "prompt": "A dazzling anime key visual of an adult woman with long flowing silver-white hair and violet eyes, wearing a stylish crimson jacket and a black pleated skirt, standing on a futuristic rooftop above a glowing neon city at night, a shower of shooting stars and a luminous galaxy across the sky, wind-swept hair, confident joyful smile, dramatic low-angle composition, vivid magenta and cyan rim lighting, intricate architecture, crisp clean line art, richly detailed beautiful anime illustration.",
                "negative_prompt": "low quality, blurry",
                "size": "256x256",
                "n": 1,
                "response_format": "b64_json",
                "steps": 4,
                "cfg_scale": 1.0,
                "flow_shift": 5.0,
                "seed": 20261020,
                "sampler": "euler"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One PNG as base64 or signed URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "created",
                    "data"
                  ],
                  "properties": {
                    "created": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "items": {
                        "type": "object",
                        "properties": {
                          "b64_json": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "headers": {
              "x-request-id": {
                "description": "Gateway job ID.",
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                }
              },
              "X-PS5-Native-Job-ID": {
                "description": "Native GPU job ID for authenticated/api/jobs and/api/images verification.",
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                }
              },
              "X-PS5-Seed": {
                "description": "Resolved native seed, including random/default requests.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "400": {
            "description": "OpenAI-shaped error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [

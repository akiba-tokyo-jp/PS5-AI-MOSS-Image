+/* Immutable publication of the import-only heap/type for one PS5 device.
+ * Pool allocation and GPU permissions are owned by the application, not here.
+ * Sticky identity keeps ordinary allocations rejected even after a pool fault.
+ */
+#include <stdatomic.h>
+static atomic_uintptr_t ps5_ai_flex_pdev = ATOMIC_VAR_INIT(0);
+static atomic_uint ps5_ai_flex_type = ATOMIC_VAR_INIT(UINT32_MAX);
+static atomic_uint ps5_ai_flex_heap = ATOMIC_VAR_INIT(UINT32_MAX);
+
+uint32_t
+ps5_ai_radv_flex_type_index(const void *pdev)
+{
+   return pdev && atomic_load_explicit(&ps5_ai_flex_pdev, memory_order_acquire) == (uintptr_t)pdev
+             ? atomic_load_explicit(&ps5_ai_flex_type, memory_order_relaxed) : UINT32_MAX;
+}
+
+uint32_t
+ps5_ai_radv_flex_heap_index(const void *pdev)
+{
+   return pdev && atomic_load_explicit(&ps5_ai_flex_pdev, memory_order_acquire) == (uintptr_t)pdev
+             ? atomic_load_explicit(&ps5_ai_flex_heap, memory_order_relaxed) : UINT32_MAX;
+}
+
+static void
+ps5_ai_radv_retire_flex_heap(struct radv_physical_device *pdev)
+{
+   uintptr_t expected = (uintptr_t)pdev;
+   if (!atomic_compare_exchange_strong_explicit(&ps5_ai_flex_pdev, &expected, UINTPTR_MAX,
+                                                memory_order_acq_rel, memory_order_acquire))
+      return;
+   atomic_store_explicit(&ps5_ai_flex_type, UINT32_MAX, memory_order_relaxed);
+   atomic_store_explicit(&ps5_ai_flex_heap, UINT32_MAX, memory_order_relaxed);
+   atomic_store_explicit(&ps5_ai_flex_pdev, 0, memory_order_release);
+}
+
+static void
+ps5_ai_radv_append_owned_flex_heap(struct radv_physical_device *pdev, unsigned *type_count)
+{
+   const uint64_t bytes = ps5_ai_flex_pool_bytes();
+   if (!bytes || bytes % PS5_AI_FLEX_PAGE_BYTES ||
+       pdev->memory_properties.memoryHeapCount >= VK_MAX_MEMORY_HEAPS || *type_count >= VK_MAX_MEMORY_TYPES)
+      return;
+   uintptr_t expected = 0;
+   if (!atomic_compare_exchange_strong_explicit(&ps5_ai_flex_pdev, &expected, UINTPTR_MAX,
+                                                memory_order_acq_rel, memory_order_acquire))
+      return; /* No replacement/reassignment of an already published device. */
+   const uint32_t heap = pdev->memory_properties.memoryHeapCount;
+   const uint32_t type = *type_count;
+   pdev->memory_properties.memoryHeaps[heap] = (VkMemoryHeap){.size = bytes, .flags = 0};
+   pdev->memory_properties.memoryTypes[type] = (VkMemoryType){
+      .propertyFlags = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT |
+                       VK_MEMORY_PROPERTY_HOST_CACHED_BIT,
+      .heapIndex = heap,
+   };
+   pdev->memory_domains[type] = RADEON_DOMAIN_GTT;
+   pdev->memory_flags[type] = RADEON_FLAG_CPU_ACCESS;
+   pdev->memory_properties.memoryHeapCount++;
+   pdev->memory_properties.memoryTypeCount = ++*type_count;
+   atomic_store_explicit(&ps5_ai_flex_type, type, memory_order_relaxed);
+   atomic_store_explicit(&ps5_ai_flex_heap, heap, memory_order_relaxed);
+   atomic_store_explicit(&ps5_ai_flex_pdev, (uintptr_t)pdev, memory_order_release);
 }
 

+struct vk_buffer_struct {
+    vk::Buffer buffer = VK_NULL_HANDLE;
+    vk::DeviceMemory device_memory = VK_NULL_HANDLE;
+    vk::MemoryPropertyFlags memory_property_flags;
+    void * ptr = nullptr;
+    void * owned_flex_ptr = nullptr;
+    uint64_t owned_flex_bytes = 0;
+    size_t size = 0;
+    vk::DeviceAddress bda_addr {};
+
+    vk_device device;
+
+    ~vk_buffer_struct() {
+        if (size == 0) {
+            return;
+        }
+        VK_LOG_DEBUG("~vk_buffer_struct(" << buffer << ", " << size << ")");
+
+        // The bridge checks positive completion and kick quiescence before Vulkan frees.
+        if (buffer) device->device.destroyBuffer(buffer);
+        if (device_memory) device->device.freeMemory(device_memory);
+        if (owned_flex_ptr && ps5_ai_flex_free(owned_flex_ptr, owned_flex_bytes))
+            ps5_ai_ggml_retain("owned_flexible_buffer_free_not_safe");
+    }
+};

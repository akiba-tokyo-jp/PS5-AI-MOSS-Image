+ * fail after this snapshot. Returns 0 when the pool is unavailable/faulted. */
+uint64_t ps5_ai_flex_largest_free_span_bytes(void);
+void ps5_ai_flex_retain_fault(const char *reason);
+#ifdef __cplusplus
+}

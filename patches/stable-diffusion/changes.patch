+        auto rounded = [&](size_t bytes) { return bytes > SIZE_MAX - (alignment - 1) ? SIZE_MAX : GGML_PAD(bytes, alignment); };
+        auto add = [](size_t a, size_t b) { return b > SIZE_MAX - a ? SIZE_MAX : a + b; };
+        auto cache_bytes = [&](const std::unordered_set<std::string>& keep,
+                               const std::unordered_set<std::string>& present) {
+            size_t total = 0;
+            for (const auto& name : keep) {
+                if (!present.count(name)) continue;
+                auto found = cut_tensors.find(name);
+                if (found == cut_tensors.end()) return SIZE_MAX;
+                auto* source = cache_source_tensor(found->second);
+                total = add(total, rounded(ggml_backend_buft_get_alloc_size(buft, source)));
+            }
+            return total;

+        auto rounded = [&](size_t bytes) { return bytes > SIZE_MAX - (alignment - 1) ? SIZE_MAX : GGML_PAD(bytes, alignment); };
+        auto add = [](size_t a, size_t b) { return b > SIZE_MAX - a ? SIZE_MAX : a + b; };

+        const size_t old_left_peak = add(rounded(left.compute_buffer_size), cache_bytes(left.live_cut_names, left_after_capture));
+        const size_t old_right_peak = add(rounded(right.compute_buffer_size), cache_bytes(right.live_cut_names, left_after_capture));

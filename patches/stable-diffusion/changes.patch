+    // Native PS5 UNet's final cut is consumed only by its final projection.
+    // Keep the same nodes/order but avoid that cache copy when GGML's actual
+    // metadata measurement proves no larger workspace or workspace+cut peak.
+    // All execution-time capacity, scratch, pin and synchronization gates run
+    // on the resulting graph as before. No prefetch or persistent buffer added.
+    static void coalesce_unet_final(ggml_backend_t backend,
+                                    ggml_cgraph* gf,
+                                    Plan& plan,
+                                    const std::unordered_set<const ggml_tensor*>& params,
+                                    const char* log_desc) {
+        if (!plan.valid || plan.segments.size() < 3 || log_desc == nullptr ||
+            std::strcmp(log_desc, "unet") != 0) {
+            return;
+        }
+        const size_t left_index = plan.segments.size() - 2;
+        const auto& left = plan.segments[left_index];
+        const auto& right = plan.segments.back();
+        if (left.group_name.compare(0, 19, "unet.output_blocks.") != 0 ||
+            right.group_name != "ggml_runner.final") {
+            return;
+        }
+        std::unordered_map<const ggml_tensor*, int> producers;
+        std::unordered_set<int> available;
+        std::unordered_map<std::string, ggml_tensor*> cut_tensors;
+        std::unordered_set<std::string> available_names;
+        for (int i = 0; i < ggml_graph_n_nodes(gf); ++i) {
+            auto* tensor = ggml_graph_node(gf, i);
+            producers[tensor] = i;
+            if (is_graph_cut_tensor(tensor)) cut_tensors[tensor->name] = tensor;
+        }
+        for (size_t i = 0; i < left_index; ++i) {
+            for (int node_index : plan.segments[i].output_node_indices) {
+                available.insert(node_index);
+                auto* tensor = ggml_graph_node(gf, node_index);
+                if (is_graph_cut_tensor(tensor)) available_names.insert(tensor->name);
+            }
+        }
+        Segment joined;
+        joined.group_name = left.group_name + "+final";
+        joined.output_node_indices = right.output_node_indices;
+        for (int node_index : left.output_node_indices) {
+            // Explicit caller outputs must survive, even when also a cut.
+            if ((ggml_graph_node(gf, node_index)->flags & GGML_TENSOR_FLAG_OUTPUT) != 0)
+                joined.output_node_indices.push_back(node_index);
+        }
+        Plan candidate;
+        build_segment(gf, candidate, joined, producers, available, backend, params, nullptr);
+        auto& merged = candidate.segments.back();
+        std::vector<int> expected_nodes = left.internal_node_indices;
+        expected_nodes.insert(expected_nodes.end(), right.internal_node_indices.begin(), right.internal_node_indices.end());
+        std::sort(expected_nodes.begin(), expected_nodes.end());
+        expected_nodes.erase(std::unique(expected_nodes.begin(), expected_nodes.end()), expected_nodes.end());
+        if (merged.internal_node_indices != expected_nodes || merged.compute_buffer_size == 0 ||
+            merged.compute_buffer_size > std::max(left.compute_buffer_size, right.compute_buffer_size)) {
+            LOG_INFO("unet final cut retained: measured merged workspace %zu exceeds prior max %zu or node union differs",

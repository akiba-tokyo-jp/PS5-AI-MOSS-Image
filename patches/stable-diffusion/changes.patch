+bool ggml_gallocr_get_plan_snapshot(
+        ggml_gallocr_t galloc, int buffer_index, struct ggml_gallocr_plan_snapshot * output) {
+    _Static_assert(GGML_VBUFFER_MAX_CHUNKS == GGML_PLAN_ADMISSION_MAX_CHUNKS,
+                   "The bounded plan snapshot must match the exact allocator");
+    if (galloc == NULL || output == NULL || buffer_index < 0 || buffer_index >= galloc->n_buffers) {
+        return false;
+    }
+    const struct ggml_dyn_tallocr * allocator = galloc->buf_tallocs[buffer_index];
+    if (allocator == NULL || allocator->n_chunks < 0 || allocator->n_chunks > GGML_VBUFFER_MAX_CHUNKS) {
+        return false;
+    }
+    memset(output, 0, sizeof(*output));
+    output->buffer_count = (uint32_t)galloc->n_buffers;
+    output->chunk_count = (uint32_t)allocator->n_chunks;
+    for (int i = 0; i < allocator->n_chunks; ++i) {
+        uint64_t bytes = (uint64_t)allocator->chunks[i]->max_size;
+        if (bytes > UINT64_MAX - output->total_bytes) {
+            return false;
+        }
+        output->chunk_bytes[i] = bytes;
+        output->total_bytes += bytes;
+        output->max_chunk_bytes = MAX(output->max_chunk_bytes, bytes);
+    }
+    return true;
+}
